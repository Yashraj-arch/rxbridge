# Application Settings
PROJECT_NAME="RxBridge Digital Prescription System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# MySQL Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/rxbridge_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Token
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000"

# File Upload Settings
CLOUDINARY_CLOUD=""
CLOUDINARY_PRESET=""
UPLOAD_DIR="uploads/lab_reports"

# AI Assistant Settings (Dual Keys with Auto-Failover & gpt-oss-120b)
GROQ_API_KEY_1="your-groq-api-key-1"
GROQ_API_KEY_2="your-groq-api-key-2"
GROQ_MODEL="openai/gpt-oss-120b"

