{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/docs",
      "destination": "/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/main.py"
    }
  ]
}
